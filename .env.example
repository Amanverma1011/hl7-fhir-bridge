# HL7 v2 -> FHIR bridge configuration. Copy to .env and adjust. Never commit a real .env.
# All values are optional; the defaults below are used when a variable is unset.

# Base URI for identifier systems when the sender doesn't provide an OID or URL.
IDENTIFIER_SYSTEM_BASE=http://hospital.example.org/identifiers

# Offset applied to HL7 timestamps that have a time but no timezone (FHIR requires one).
DEFAULT_TIMEZONE=+05:30

# FHIR R4 server to forward transaction bundles to. Leave empty to convert only.
# Local HAPI (docker compose): http://localhost:8080/fhir
FHIR_SERVER_URL=
# Bearer token for the FHIR server, if it requires one (e.g. a cloud FHIR service).
FHIR_AUTH_TOKEN=
FHIR_TIMEOUT_SECONDS=15

# MLLP listener. Use 0.0.0.0 to accept connections from other machines.
MLLP_HOST=127.0.0.1
MLLP_PORT=2575

# Reject messages larger than this many bytes (REST and MLLP).
MAX_MESSAGE_BYTES=1048576

# MSH-3 / MSH-4 used in ACKs when the inbound message names no receiver.
RECEIVING_APPLICATION=HL7FHIRBRIDGE
RECEIVING_FACILITY=

LOG_LEVEL=INFO
